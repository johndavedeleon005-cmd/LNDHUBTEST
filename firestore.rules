rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'johndavedeleon005@gmail.com' ||
        request.auth.token.email == 'master@jiangnanhotpot.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'grantedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.grantedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'position',
          'branch',
          'role',
          'status',
          'ndaAccepted',
          'ndaSignature',
          'ndaAcceptedAt',
          'credentialPass',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'position',
          'branch',
          'role',
          'status',
          'ndaAccepted',
          'ndaSignature',
          'ndaAcceptedAt',
          'credentialPass',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.position is string && data.position.size() >= 1 && data.position.size() <= 120 &&
        data.branch is string && data.branch.size() >= 1 && data.branch.size() <= 160 &&
        (data.role == 'master' || data.role == 'staff') &&
        (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
        data.ndaAccepted is bool && data.ndaAccepted == true &&
        data.ndaSignature is string && data.ndaSignature == 'I AGREE' &&
        data.ndaAcceptedAt is string && data.ndaAcceptedAt.size() >= 1 && data.ndaAcceptedAt.size() <= 64 &&
        data.credentialPass is string && data.credentialPass.size() >= 1 && data.credentialPass.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomDocument(data) {
      return data.keys().hasAll([
          'id',
          'code',
          'title',
          'type',
          'category',
          'revision',
          'effectiveDate',
          'summary',
          'contentBody',
          'keyTakeaways',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'code',
          'title',
          'type',
          'category',
          'revision',
          'effectiveDate',
          'summary',
          'contentBody',
          'keyTakeaways',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 64 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        (data.type == 'policy' || data.type == 'sop' || data.type == 'guide' || data.type == 'checklist') &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
        data.revision is number && data.revision >= 1 && data.revision <= 1000 &&
        data.effectiveDate is string && data.effectiveDate.size() >= 1 && data.effectiveDate.size() <= 64 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 4000 &&
        data.contentBody is string && data.contentBody.size() >= 1 && data.contentBody.size() <= 50000 &&
        data.keyTakeaways is string && data.keyTakeaways.size() >= 1 && data.keyTakeaways.size() <= 10000 &&
        (data.visibility == 'approved_staff' || data.visibility == 'master_only') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCertificate(data) {
      return data.keys().hasAll([
          'id',
          'serialCode',
          'staffName',
          'staffEmail',
          'staffPosition',
          'staffBranch',
          'quizTitle',
          'score',
          'totalQuestions',
          'percentage',
          'status',
          'issuedAt',
          'verifiedBy',
          'visibility',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'serialCode',
          'staffName',
          'staffEmail',
          'staffPosition',
          'staffBranch',
          'quizTitle',
          'score',
          'totalQuestions',
          'percentage',
          'status',
          'issuedAt',
          'verifiedBy',
          'visibility',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.serialCode is string && data.serialCode.size() >= 1 && data.serialCode.size() <= 64 &&
        data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120 &&
        data.staffEmail is string && data.staffEmail.size() >= 3 && data.staffEmail.size() <= 254 &&
        data.staffPosition is string && data.staffPosition.size() >= 1 && data.staffPosition.size() <= 120 &&
        data.staffBranch is string && data.staffBranch.size() >= 1 && data.staffBranch.size() <= 160 &&
        data.quizTitle is string && data.quizTitle.size() >= 1 && data.quizTitle.size() <= 240 &&
        data.score is number && data.score >= 0 && data.score <= 1000 &&
        data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 1000 &&
        data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
        (data.status == 'verified' || data.status == 'revoked') &&
        data.issuedAt is string && data.issuedAt.size() >= 1 && data.issuedAt.size() <= 64 &&
        data.verifiedBy is string && data.verifiedBy.size() >= 1 && data.verifiedBy.size() <= 160 &&
        data.visibility == 'portal_verified' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(adminId) && isValidAdminRecord(incoming()) && isAdmin() && incoming().uid == adminId && incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }

    // 5. Collection Rules: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && resource.data.ndaAccepted == true;
      allow list: if resource.data.ndaAccepted == true && resource.data.ndaSignature == 'I AGREE';

      allow create: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (incoming().role == 'staff' && incoming().status == 'pending') ||
          isAdmin()
        );

      allow update: if isValidUserProfile(incoming()) &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().ndaAccepted == existing().ndaAccepted &&
        incoming().ndaSignature == existing().ndaSignature &&
        incoming().ndaAcceptedAt == existing().ndaAcceptedAt &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'role',
          'status',
          'displayName',
          'position',
          'branch',
          'credentialPass',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    // 6. Collection Rules: /custom_documents/{docId}
    match /custom_documents/{docId} {
      allow get: if isValidId(docId) && resource.data.visibility == 'approved_staff';
      allow list: if resource.data.visibility == 'approved_staff';

      allow create: if isValidId(docId) &&
        isValidCustomDocument(incoming()) &&
        incoming().id == docId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidCustomDocument(incoming()) &&
        isValidId(docId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'code',
          'title',
          'type',
          'category',
          'revision',
          'effectiveDate',
          'summary',
          'contentBody',
          'keyTakeaways',
          'visibility',
          'updatedAt'
        ]);

      allow delete: if isValidId(docId);
    }

    // 7. Collection Rules: /certificates/{certId}
    match /certificates/{certId} {
      allow get: if isValidId(certId) && resource.data.visibility == 'portal_verified';
      allow list: if resource.data.visibility == 'portal_verified';

      allow create: if isValidId(certId) &&
        isValidCertificate(incoming()) &&
        incoming().id == certId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidCertificate(incoming()) &&
        isValidId(certId) &&
        incoming().id == existing().id &&
        incoming().serialCode == existing().serialCode &&
        incoming().staffEmail == existing().staffEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'staffName',
          'staffPosition',
          'staffBranch',
          'quizTitle',
          'score',
          'totalQuestions',
          'percentage',
          'status',
          'issuedAt',
          'verifiedBy',
          'visibility',
          'updatedAt'
        ]);

      allow delete: if isValidId(certId) && isAdmin();
    }
  }
}
